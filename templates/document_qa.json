{
  "id": "template_qa",
  "name": "Document Q&A",
  "description": "Ask questions about documents using local LLM — answers with sources and confidence",
  "version": "1.0",
  "nodes": [
    {"instance_id": "guard", "node_type": "guard_start", "config": {"watch_dirs": "./data", "monitor_network": true}, "position": {"x": 50, "y": 250}},
    {"instance_id": "file", "node_type": "file_input", "config": {"path": "./data/samples/sample_invoice.txt"}, "position": {"x": 250, "y": 150}},
    {"instance_id": "pdf", "node_type": "pdf_loader", "config": {"engine": "pymupdf"}, "position": {"x": 450, "y": 150}},
    {"instance_id": "question", "node_type": "text_input", "config": {"text": "What is the total amount and who is the vendor?", "label": "Question"}, "position": {"x": 250, "y": 350}},
    {"instance_id": "qa", "node_type": "document_qa", "config": {"model": "llama3.2", "max_context": 4000, "temperature": 0.1}, "position": {"x": 700, "y": 250}},
    {"instance_id": "eval", "node_type": "evaluate", "config": {"preset": "rag", "threshold": 0.5}, "position": {"x": 950, "y": 250}},
    {"instance_id": "hallcheck", "node_type": "hallucination_check", "config": {"checks": "entity,numeric,fabricated"}, "position": {"x": 950, "y": 400}},
    {"instance_id": "display", "node_type": "display_result", "config": {"display_mode": "cards"}, "position": {"x": 1200, "y": 200}},
    {"instance_id": "audit", "node_type": "guard_report", "config": {"format": "json"}, "position": {"x": 1200, "y": 400}}
  ],
  "connections": [
    {"source": "file", "source_port": "file_path", "target": "pdf", "target_port": "file_path"},
    {"source": "pdf", "source_port": "text", "target": "qa", "target_port": "text"},
    {"source": "question", "source_port": "text", "target": "qa", "target_port": "question"},
    {"source": "qa", "source_port": "answer", "target": "eval", "target_port": "answer"},
    {"source": "pdf", "source_port": "text", "target": "eval", "target_port": "context"},
    {"source": "qa", "source_port": "answer", "target": "hallcheck", "target_port": "answer"},
    {"source": "pdf", "source_port": "text", "target": "hallcheck", "target_port": "context"},
    {"source": "qa", "source_port": "answer", "target": "display", "target_port": "data"},
    {"source": "qa", "source_port": "confidence", "target": "display", "target_port": "confidence"},
    {"source": "qa", "source_port": "sources", "target": "display", "target_port": "sources"},
    {"source": "guard", "source_port": "guard_session", "target": "audit", "target_port": "guard_session"}
  ]
}
