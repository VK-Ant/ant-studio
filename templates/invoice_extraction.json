{
  "id": "template_invoice",
  "name": "Invoice Extraction",
  "description": "Extract vendor, date, amount from PDF invoices with quality validation and privacy audit",
  "version": "1.0",
  "nodes": [
    {"instance_id": "guard", "node_type": "guard_start", "config": {"watch_dirs": "./data", "monitor_network": true}, "position": {"x": 50, "y": 200}},
    {"instance_id": "input", "node_type": "file_input", "config": {"path": "./data/invoice.pdf"}, "position": {"x": 250, "y": 200}},
    {"instance_id": "pdf", "node_type": "pdf_loader", "config": {"engine": "pymupdf"}, "position": {"x": 450, "y": 200}},
    {"instance_id": "extract", "node_type": "docqwise_extract", "config": {"fields": "vendor,date,amount,invoice_number", "model": "default"}, "position": {"x": 650, "y": 200}},
    {"instance_id": "eval", "node_type": "evaluate", "config": {"preset": "doceval", "threshold": 0.6}, "position": {"x": 850, "y": 200}},
    {"instance_id": "gate", "node_type": "confidence_gate", "config": {"threshold": 0.7}, "position": {"x": 1050, "y": 200}},
    {"instance_id": "display", "node_type": "display_result", "config": {"display_mode": "table"}, "position": {"x": 1250, "y": 100}},
    {"instance_id": "export", "node_type": "export_csv", "config": {"output_path": "./output/invoices.csv"}, "position": {"x": 1250, "y": 200}},
    {"instance_id": "review", "node_type": "human_review", "config": {"auto_approve": true}, "position": {"x": 1250, "y": 350}},
    {"instance_id": "audit", "node_type": "guard_report", "config": {"format": "json"}, "position": {"x": 1450, "y": 200}}
  ],
  "connections": [
    {"source": "input", "source_port": "file_path", "target": "pdf", "target_port": "file_path"},
    {"source": "pdf", "source_port": "text", "target": "extract", "target_port": "text"},
    {"source": "extract", "source_port": "fields", "target": "eval", "target_port": "answer"},
    {"source": "pdf", "source_port": "text", "target": "eval", "target_port": "context"},
    {"source": "eval", "source_port": "score", "target": "gate", "target_port": "score"},
    {"source": "extract", "source_port": "fields", "target": "gate", "target_port": "data"},
    {"source": "gate", "source_port": "pass_data", "target": "display", "target_port": "data"},
    {"source": "eval", "source_port": "score", "target": "display", "target_port": "confidence"},
    {"source": "gate", "source_port": "pass_data", "target": "export", "target_port": "data"},
    {"source": "gate", "source_port": "fail_data", "target": "review", "target_port": "data"},
    {"source": "guard", "source_port": "guard_session", "target": "audit", "target_port": "guard_session"},
    {"source": "export", "source_port": "file_path", "target": "audit", "target_port": "data"}
  ]
}
