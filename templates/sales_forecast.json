{
  "id": "template_forecast",
  "name": "Sales Forecast",
  "description": "Load time-series data, forecast future values, detect anomalies",
  "version": "1.0",
  "nodes": [
    {"instance_id": "input", "node_type": "file_input", "config": {"path": "./data/samples/daily_sales.csv"}, "position": {"x": 50, "y": 200}},
    {"instance_id": "loader", "node_type": "data_loader", "config": {"target": "value", "time_col": "date"}, "position": {"x": 300, "y": 200}},
    {"instance_id": "forecast", "node_type": "forecast", "config": {"model": "arima", "horizon": 30, "target": "value", "time_col": "date"}, "position": {"x": 550, "y": 100}},
    {"instance_id": "anomaly", "node_type": "anomaly_detect", "config": {"method": "zscore", "target": "value", "threshold": 2.0}, "position": {"x": 550, "y": 300}},
    {"instance_id": "display_fc", "node_type": "display_result", "config": {"display_mode": "json"}, "position": {"x": 800, "y": 100}},
    {"instance_id": "display_an", "node_type": "display_result", "config": {"display_mode": "cards"}, "position": {"x": 800, "y": 300}},
    {"instance_id": "export", "node_type": "export_json", "config": {"output_path": "./output/forecast_results.json"}, "position": {"x": 1050, "y": 200}}
  ],
  "connections": [
    {"source": "input", "source_port": "file_path", "target": "loader", "target_port": "file_path"},
    {"source": "loader", "source_port": "data", "target": "forecast", "target_port": "data"},
    {"source": "loader", "source_port": "data", "target": "anomaly", "target_port": "data"},
    {"source": "forecast", "source_port": "forecast", "target": "display_fc", "target_port": "data"},
    {"source": "anomaly", "source_port": "anomalies", "target": "display_an", "target_port": "data"},
    {"source": "anomaly", "source_port": "anomaly_count", "target": "display_an", "target_port": "confidence"},
    {"source": "forecast", "source_port": "forecast", "target": "export", "target_port": "data"}
  ]
}
